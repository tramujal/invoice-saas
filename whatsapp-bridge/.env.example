# Experimental WhatsApp bridge -- environment variables.
# See docs/whatsapp.md in the main repo for the full explanation of every
# variable. This service is disabled-by-default and must be explicitly
# opted into; see the main repo's docker-compose.yml "experimental" profile.

# Port this bridge's own HTTP server (health + control endpoints) listens on.
PORT=3100

# Must match the main backend's WHATSAPP_BRIDGE_SECRET exactly -- the
# shared HMAC secret used to sign/verify every request in both
# directions. Generate with e.g. `openssl rand -hex 32`.
WHATSAPP_BRIDGE_SECRET=

# The main backend's base URL, used to POST normalized inbound messages
# to POST {BACKEND_BASE_URL}/whatsapp/bridge/inbound.
BACKEND_BASE_URL=http://localhost:8000

# How far a signature's own timestamp may drift from wall-clock time
# before being rejected as a possible replay -- must match the backend's
# WHATSAPP_SIGNATURE_TOLERANCE_SECONDS.
SIGNATURE_TOLERANCE_SECONDS=300

# Directory where whatsapp-web.js persists its login session (LocalAuth).
# MUST be a dedicated, persistent volume in any real deployment -- see
# docs/whatsapp.md's "Session persistence" section: this data is
# equivalent to full WhatsApp account access if it leaks. Never commit
# it; see .gitignore.
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Explicit HTTP timeout for outbound calls this bridge makes to the
# backend (posting an inbound message).
BACKEND_REQUEST_TIMEOUT_SECONDS=10

# Bounded reconnect backoff (see src/provider/WebJsWhatsAppProvider.ts) --
# never an infinite/unbounded retry loop.
RECONNECT_INITIAL_DELAY_SECONDS=5
RECONNECT_MAX_DELAY_SECONDS=300
RECONNECT_MAX_ATTEMPTS=20

LOG_LEVEL=info
