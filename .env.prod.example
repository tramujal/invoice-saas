# Copy to `.env` (repo root, next to docker-compose.prod.yml) and fill in
# real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
# Never commit the real .env file (already gitignored).
#
# Every REQUIRED variable below has no safe default -- docker-compose.prod.yml
# uses Compose's own `${VAR:?message}` syntax for each one, so
# `docker compose` refuses to start at all (with that message) if you
# forget to set it, rather than silently booting with something wrong.
# Every OPTIONAL variable already has a documented default in
# docker-compose.prod.yml itself and only needs setting here to change
# that default.

# --- REQUIRED ---

# Real Postgres password for the `db` service. Generate one, don't
# reuse a password from anywhere else:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the SAME value for every deploy of this stack -- rotating it
# invalidates every currently-logged-in session.
JWT_SECRET_KEY=

# The public domain the FastAPI backend will be served at (through
# Caddy, which obtains its TLS certificate for this exact hostname). Must
# already resolve via a real DNS A/AAAA record to this host's public IP
# before starting the stack, or Caddy's automatic HTTPS (Let's Encrypt)
# will fail. No scheme, no path -- just the hostname, e.g.:
DOMAIN_API=api.yourdomain.com

# The public domain the Next.js frontend will be served at. Same DNS
# requirement as DOMAIN_API above.
DOMAIN_FRONTEND=app.yourdomain.com

# --- OPTIONAL (safe defaults already set in docker-compose.prod.yml) ---

# POSTGRES_DB=invoicing
# POSTGRES_USER=invoicing
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# LOG_LEVEL=INFO
# Number of uvicorn worker processes for the `backend` service -- see
# docker-compose.prod.yml's own comment on this exact variable for what
# to set it to and the one caveat (per-worker rate-limit counters).
# WEB_CONCURRENCY=2
# WORKER_QUEUE=default
# WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_IDLE_BACKOFF_MAX_SECONDS=30
# WORKER_LEASE_DURATION_SECONDS=300
# WORKER_BATCH_SIZE=5

# --- OPTIONAL (unset by default -- app starts fine, affected features 503) ---

# Resend (https://resend.com) -- required together, only for
# POST .../send-email and for actually delivering password-reset emails.
RESEND_API_KEY=
EMAIL_FROM=

# AI Business Assistant -- see .env.example's own AI_* documentation for
# the full set of tunable limits (those all keep their code-level
# defaults here; add them to docker-compose.prod.yml's backend
# environment: block if you need to override any of them in this
# deployment path).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# REQUIRED if AI_PROVIDER is set at all, since ENVIRONMENT=production
# here has no dev fallback for this one (see app/ai/factory.py):
AI_MODEL=

# Google Sign-In -- see docs/google_auth.md. Disabled by default even if
# credentials are set below (GOOGLE_OAUTH_ENABLED is a separate opt-in).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Google Cloud OAuth
# client -- https://<DOMAIN_API>/auth/google/callback in this path.
GOOGLE_REDIRECT_URI=
