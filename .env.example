# Copy to .env and fill in real values. Never commit the real .env file.

# --- Backend (app/) ---

# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
# For Postgres, either "postgresql://..." or "postgres://..." is accepted —
# both are automatically rewritten to use the psycopg3 driver.
DATABASE_URL=sqlite:///./invoices.db
# DATABASE_URL=postgresql://user:password@localhost:5432/invoices

# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be set to a real secret before deploying — the app falls back to an
# insecure default (with a warning) if this is unset.
JWT_SECRET_KEY=

# Access token lifetime, in minutes. Defaults to 1440 (24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# "development" (default) or "production". When "production", the app
# refuses to start unless JWT_SECRET_KEY is set to a real secret, and
# logs a warning (not fatal) if CORS_ALLOWED_ORIGINS is left unset.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local Next.js dev origins when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Number of trusted reverse-proxy hops in front of this service, for
# X-Forwarded-For-based client-IP resolution (app.rate_limit). 0 (default)
# means "no proxy — trust the raw TCP peer", correct for local dev and for
# any deployment with nothing in front of it. Set to 1 behind exactly one
# reverse proxy (Render's own edge proxy, or the Caddy service in
# docker-compose.prod.yml) — see app/rate_limit.py's own module docstring
# for why getting this wrong is a real security issue, not just cosmetic.
TRUSTED_PROXY_HOPS=0

# Python logging level for the whole app (root logger). One of DEBUG,
# INFO (default), WARNING, ERROR, CRITICAL. An unrecognized value falls
# back to INFO rather than failing startup.
LOG_LEVEL=INFO

# Resend (https://resend.com) — required only for POST .../send-email and
# for actually delivering password-reset emails. Without these, sending
# fails silently server-side (forgot-password still returns its generic
# success response either way) and the invoice send-email endpoint returns
# 503; everything else works unaffected.
RESEND_API_KEY=
EMAIL_FROM=invoices@yourdomain.com

# Base URL of the deployed frontend, used to build the password-reset link
# sent by email (<FRONTEND_BASE_URL>/reset-password?token=...). Defaults to
# the local Next.js dev origin when unset.
FRONTEND_BASE_URL=http://localhost:3000

# AI Business Assistant (POST .../assistant/chat) — provider-agnostic; see
# app/ai/base.py (interface), app/ai/factory.py (provider selection),
# app/ai/anthropic_provider.py and app/ai/gemini_provider.py
# (implementations). Without a valid provider configured, the endpoint
# returns a clean 503 ("AI assistant is not configured") and nothing else
# in the app is affected.

# Which provider to use: "anthropic" (default if unset) or "gemini".
# Unknown values also return the 503 above, with a message naming the
# valid options. Switching providers only ever means changing this value
# and setting *that* provider's own API key below — the other provider's
# key is never read.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic. Calls Anthropic's Messages API.
ANTHROPIC_API_KEY=
# Required when AI_PROVIDER=gemini. Calls Google's Gemini API via the
# official google-genai SDK.
GEMINI_API_KEY=

# The model id to call, for whichever provider is selected above. In
# development (ENVIRONMENT unset or not "production"), an unset AI_MODEL
# falls back to a provider-specific default ("claude-sonnet-5" for
# Anthropic, "gemini-2.5-flash" for Gemini) with a logged warning — a
# convenience for local testing only. In production (ENVIRONMENT=production),
# AI_MODEL MUST be set explicitly: the app will not silently guess a model
# id that could become invalid as models are retired, since that
# assumption is exactly what led to this being required rather than
# hardcoded. See app/ai/factory.py.
AI_MODEL=
# Maximum tokens the assistant may generate in a single reply.
AI_MAX_OUTPUT_TOKENS=1024
# How long to wait for the provider before giving up (seconds).
AI_REQUEST_TIMEOUT_SECONDS=30
# Input validation limits for the chat endpoint — conservative defaults,
# rarely need changing. See app/ai/limits.py.
AI_MAX_USER_MESSAGE_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_HISTORY_MESSAGE_LENGTH=2000
AI_MAX_HISTORY_TOTAL_CHARS=8000
AI_MAX_CONTEXT_CHARS=6000

# Payment provider (Stripe) — see docs/billing_providers.md for the full
# reference. Commercial plans (app/models.py Plan/Subscription) are
# enforced regardless of this section; it's what actually charges a
# card. Unset (or "none") is the fully valid default: BillingService runs
# against NullBillingProvider, which fails closed (never silently
# no-ops) if a provider-backed method is ever called without one
# configured.
BILLING_PROVIDER=none
# Required when BILLING_PROVIDER=stripe. Server-side secret key —
# never the publishable key. Get both from the Stripe Dashboard.
STRIPE_API_KEY=
# Required when BILLING_PROVIDER=stripe. Verifies the
# Stripe-Signature header on inbound events at POST
# /billing/webhooks/stripe — see app.billing.stripe_provider.
STRIPE_WEBHOOK_SECRET=
# Optional — how far a webhook's own timestamp may drift from wall-clock
# time before it's rejected as a possible replay. Defaults to 300
# (seconds), Stripe's own reference-implementation default.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# One price id per (plan, billing period) your Stripe account actually
# sells, e.g. STRIPE_PRICE_ID__PRO__MONTHLY=price_xxx,
# STRIPE_PRICE_ID__PRO__YEARLY=price_xxx. Only read at the moment a
# checkout for that exact plan/period is started — a plan with no
# matching price id simply can't be checked out into yet.
# STRIPE_PRICE_ID__<PLAN_CODE>__<MONTHLY|YEARLY>=

# --- WhatsApp Assistant (experimental, UNOFFICIAL -- see docs/whatsapp.md) ---
# An unofficial WhatsApp Web transport for the existing AI assistant.
# Disabled by default, and the app starts and functions completely
# normally with none of this set -- see app/whatsapp/provider_factory.py.
# NOT an official WhatsApp Business/Meta Cloud API integration; do not
# enable this in a real production deployment (see docs/whatsapp.md's
# "Unofficial WhatsApp risks" section).

# Master kill-switch. "false" (default) or unset: every WhatsApp code path
# resolves to a no-op NullWhatsAppProvider, and Settings -> WhatsApp shows
# "transport disabled" to every organization regardless of plan.
WHATSAPP_ENABLED=false
# "null" (default) or "bridge". "bridge" additionally requires
# WHATSAPP_BRIDGE_URL and WHATSAPP_BRIDGE_SECRET below, or it falls back to
# Null anyway (see is_whatsapp_transport_configured() — this is how the
# Settings page distinguishes "disabled" from "enabled but unconfigured").
WHATSAPP_PROVIDER=null
# Base URL of the separate whatsapp-bridge Node service (see
# whatsapp-bridge/ in the repo root). Required when WHATSAPP_PROVIDER=bridge.
WHATSAPP_BRIDGE_URL=http://localhost:3100
# Shared HMAC secret the backend and whatsapp-bridge use to sign/verify
# every request to each other — must be identical on both processes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_BRIDGE_SECRET=
# Where whatsapp-bridge persists its WhatsApp Web session (LocalAuth) —
# read by the bridge process, not this backend; documented here since it's
# part of the same feature. MUST be a dedicated, persistent, gitignored
# path — session data there is equivalent to full account access if it
# leaks. Defaults to ./.wwebjs_auth under the bridge's own working
# directory when unset.
WHATSAPP_SESSION_PATH=
# Longest inbound WhatsApp text message this app will interpret.
WHATSAPP_MESSAGE_MAX_LENGTH=1000
# Voice-note limits enforced before transcription is ever attempted.
WHATSAPP_AUDIO_MAX_BYTES=5242880
WHATSAPP_AUDIO_MAX_SECONDS=120
# Short-lived, in-memory (never persisted to the database) conversation
# context per organization+user+phone — see app/whatsapp/context_store.py.
WHATSAPP_CONTEXT_TTL_MINUTES=15
WHATSAPP_CONTEXT_MAX_MESSAGES=10
# Documented, not actually configurable in practice — every mutating
# WhatsApp command always requires CONFIRMAR/CANCELAR. Left as an env var
# only so a misconfigured "false" is visible in startup logs rather than
# silently ignored; see app/whatsapp/config.py.
WHATSAPP_REQUIRE_CONFIRMATION=true
# How long this backend waits for the bridge to respond before treating it
# as unavailable (seconds).
WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
# How far a bridge request's signed timestamp may drift from wall-clock
# time before it's rejected as a possible replay (seconds).
WHATSAPP_SIGNATURE_TOLERANCE_SECONDS=300
# Phone-linking one-time code lifecycle (Settings -> WhatsApp).
WHATSAPP_VERIFICATION_CODE_TTL_MINUTES=10
WHATSAPP_MAX_VERIFICATION_ATTEMPTS=5

# --- Background worker (app/jobs/worker.py) ---
# Only read by the separate `python -m app.jobs.worker` process, never by
# the web API itself — see app/job_config.py. Every one of these is
# optional; the worker runs correctly with none of them set, using the
# defaults shown below. Not needed at all if you never run the worker
# (webhook events/notification emails just queue up undelivered — see
# README.md's own Deployment/Architecture sections).
WORKER_QUEUE=default
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_IDLE_BACKOFF_MAX_SECONDS=30
WORKER_LEASE_DURATION_SECONDS=300
WORKER_BATCH_SIZE=5

# --- Frontend (frontend/) ---

# Default API base URL shown on the login page.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
